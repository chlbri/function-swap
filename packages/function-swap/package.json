{
  "name": "@bemedev/function-swap",
  "version": "0.2.3",
  "description": "A TypeScript utility that lets you remap a function's parameters by swapping their order or decomposing them into named keys — without changing the original function signature.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.js",
  "files": [
    "lib"
  ],
  "author": {
    "email": "bri_lvi@icloud.com",
    "name": "chlbri",
    "url": "https://bemedev.vercel.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chlbri/function-swap"
  },
  "maintainers": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "contributors": [
    {
      "email": "bri_lvi@icloud.com",
      "name": "chlbri",
      "url": "https://bemedev.vercel.app"
    }
  ],
  "keywords": [
    "swap",
    "function",
    "builder",
    "high-order function",
    "function builder",
    "function swap",
    "bemedev"
  ],
  "scripts": {
    "build": "pnpm run rm:lib && pnpm run rolldown",
    "rm:lib": "pnpx rimraf ./lib",
    "test": "vitest run",
    "fmt": "oxfmt",
    "lint": "oxlint --fix && pnpm run fmt",
    "pretest": "pnpm run build && pnpm run size",
    "posttest": "exit 0",
    "test:only": "pnpm run test --no-coverage",
    "_ci": "pnpm run lint && pnpm run test",
    "size": "size-limit",
    "rolldown": "rolldown -c"
  },
  "peerDependencies": {
    "@bemedev/decompose": "2.2.0"
  },
  "devDependencies": {
    "@bemedev/decompose": "^2.2.0",
    "@bemedev/dev-utils": "^1.1.1",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  },
  "size-limit": [
    {
      "path": "lib/**/*.js",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.d.ts",
      "limit": "10kb"
    },
    {
      "path": "lib/**/*.cjs",
      "limit": "10 kb"
    }
  ]
}
